<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vocabulary Flashcards</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background-color: #f0f8ff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            color: #333;
        }
        
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .header h1 {
            margin: 0;
            color: #2c3e50;
        }
        
        .progress {
            font-size: 1.1rem;
            color: #7f8c8d;
            margin-top: 10px;
        }
        
        .flashcard-container {
            perspective: 1000px;
            width: 90%;
            max-width: 500px;
            height: 300px;
            margin-bottom: 30px;
        }
        
        .flashcard {
            width: 100%;
            height: 100%;
            position: relative;
            transition: transform 0.6s;
            transform-style: preserve-3d;
            cursor: pointer;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            border-radius: 20px;
        }
        
        .flashcard.is-flipped {
            transform: rotateY(180deg);
        }
        
        .card-face {
            width: 100%;
            height: 100%;
            position: absolute;
            backface-visibility: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 600;
            text-align: center;
            border-radius: 20px;
            padding: 20px;
            box-sizing: border-box;
        }
        
        .card-front {
            background-color: #ffffff;
            color: #2980b9;
        }
        
        .card-back {
            background-color: #2980b9;
            color: #ffffff;
            transform: rotateY(180deg);
            font-size: 1.8rem;
        }
        
        .controls {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        button {
            padding: 12px 25px;
            font-size: 1.1rem;
            font-family: 'Prompt', sans-serif;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            background-color: #34495e;
            color: white;
            transition: background-color 0.3s, transform 0.1s;
        }
        
        button:hover {
            background-color: #2c3e50;
        }
        
        button:active {
            transform: scale(0.95);
        }
        
        .shuffle-btn {
            background-color: #e67e22;
        }
        
        .shuffle-btn:hover {
            background-color: #d35400;
        }
        
        @media (max-width: 600px) {
            .card-face {
                font-size: 1.5rem;
            }
            button {
                padding: 10px 20px;
                font-size: 1rem;
            }
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>Vocabulary Flashcards</h1>
