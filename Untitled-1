            <div class="card-face card-back" id="meaningDisplay">กำลังโหลด...</div>
        </div>
    </div>

    <div class="controls">
        <button onclick="prevCard()">&#8592; Previous</button>
        <button onclick="flipCard()">Flip (พลิก)</button>
        <button onclick="nextCard()">Next &#8594;</button>
        <button class="shuffle-btn" onclick="shuffleCards()">Shuffle (สลับคำ)</button>
